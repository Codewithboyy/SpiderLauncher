<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SpiderLauncher" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.SpiderLauncher.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spider_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_spider_web</item>
        <item name="postSplashScreenTheme">@style/Theme.SpiderLauncher</item>
    </style>

</resources>
